# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
LOG_PRETTY=true
CORS_ORIGINS=http://localhost:3000
# Proxy hops whose X-Forwarded-For is trusted (the web BFF). 0 = use the socket address.
TRUST_PROXY_HOPS=1
# Swagger UI at /docs and the OpenAPI JSON at /docs/openapi.json (default: on unless production).
API_DOCS_ENABLED=true

# Database
DATABASE_URL=postgresql://patients:patients@localhost:5432/patients?schema=public

# Auth
# Must be >= 32 chars. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_TTL_SECONDS=1800
BCRYPT_COST=12

# Resilience demo: simulated flaky database
# Each DB query gets random latency and fails with probability CHAOS_FAILURE_RATE.
# The API absorbs most failures with jittered retries; the rest surface as 503 + Retry-After.
CHAOS_ENABLED=true
CHAOS_FAILURE_RATE=0.15
CHAOS_LATENCY_MIN_MS=50
CHAOS_LATENCY_MAX_MS=500
DB_RETRY_MAX_ATTEMPTS=3
DB_RETRY_BASE_DELAY_MS=50
