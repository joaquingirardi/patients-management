{
  "name": "@pm/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "The API contract: Zod schemas, inferred types, roles, permissions and error codes shared by the API and the web app.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@pm/eslint-config": "workspace:*",
    "@pm/tsconfig": "workspace:*",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}
